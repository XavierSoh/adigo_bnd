PORT=3800

DB_USER=postgres
DB_PASSWORD=change_me
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=adigo_db

NODE_ENV=development

# Required. Generate a strong random value, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# The server refuses to start without it (see src/utils/env.ts).
JWT_SECRET=

# Optional. bcrypt salt rounds, defaults to 10 if unset.
SALT=10

FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=

# Orange Money (OMAPI) — see spec/Guide_Utilisateur_OMAPI___Production.pdf
# Same base URL for sandbox and production; which one you hit depends only
# on which set of keys (Bac à sable vs Production) these hold.
ORANGE_MONEY_BASE_URL=https://api-s1.orange.cm
# OAuth2 client credentials ("Clef/Secret du consommateur"), used for POST /token
ORANGE_MONEY_CONSUMER_KEY=
ORANGE_MONEY_CONSUMER_SECRET=
# api_username/api_password from the Orange onboarding email — combined into
# the X-AUTH-TOKEN header on every business endpoint
ORANGE_MONEY_API_USERNAME=
ORANGE_MONEY_API_PASSWORD=
# The MERCHANT's own Orange Money channel account (channelUserMsisdn/pin) —
# never the paying customer's
ORANGE_MONEY_MERCHANT_MSISDN=
ORANGE_MONEY_MERCHANT_PIN=
# Public URL Orange calls back on with the final payment status
ORANGE_MONEY_NOTIF_URL=https://api.adigobookings.com/v1/api/payments/orange-money/webhook

# Email (via the self-hosted Postal mail server). Optional: if any of these
# are unset, email sending is silently disabled (a warning is logged once)
# rather than crashing the server - see src/services/email.service.ts.
# In production this points at Postal's SMTP listener on the same VPS
# (127.0.0.1:25); the SMTP_USER/PASS pair is a Postal "SMTP" credential
# (see BOOKING_MODULE_NOTES.md, "Email notifications" section, for how it
# was provisioned and which domain/organization it belongs to).
SMTP_HOST=127.0.0.1
SMTP_PORT=25
SMTP_USER=
SMTP_PASS=
SMTP_FROM=ADIGO <noreply@adigobookings.com>

# Base URL used to build links embedded in emails (e.g. the email
# verification link). No trailing slash.
API_BASE_URL=https://api.adigobookings.com

# "Sign in with Google" (POST /customers/login-google). The server refuses
# every call to that route without it (see src/utils/env.ts's requireEnv).
# This is the OAuth 2.0 Web client ID from Google Cloud Console / Firebase
# console (Authentication → Sign-in method → Google) - NOT the Android/iOS
# client ID, even for a mobile app: google_sign_in issues ID tokens whose
# audience is the Web client tied to the same Firebase project. As of this
# writing google-services.json has no oauth_client entries yet - Google
# Sign-In needs to be enabled in the Firebase console first before this can
# be set to a real value.
GOOGLE_CLIENT_ID=
