  users_bus_created_byTousers users?           @relation("bus_created_byTousers", fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users_bus_deleted_byTousers users?           @relation("bus_deleted_byTousers", fields: [deleted_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
