generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model access_right {
  id                                   Int                     @id @default(autoincrement())
  key                                  String                  @unique @db.VarChar(50)
  module                               String
  module_name_en                       String                  @db.VarChar(100)
  module_name_fr                       String                  @db.VarChar(100)
  description_en                       String?                 @db.VarChar(255)
  description_fr                       String?                 @db.VarChar(255)
  is_deleted                           Boolean?                @default(false)
  deleted_at                           DateTime?               @db.Timestamp(6)
  deleted_by                           Int?
  created_by                           Int?
  users_access_right_created_byTousers users?                  @relation("access_right_created_byTousers", fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users_access_right_deleted_byTousers users?                  @relation("access_right_deleted_byTousers", fields: [deleted_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  profile_access_rights                profile_access_rights[]
}

model activity_log {
  id          Int       @id @default(autoincrement())
  user_id     Int?
  action_type String    @db.VarChar(50)
  entity_type String?   @db.VarChar(50)
  entity_id   Int?
  description String?
  metadata    Json?
  created_at  DateTime? @default(now()) @db.Timestamp(6)
  customer    customer? @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([entity_type, entity_id], map: "idx_activity_log_entity")
  @@index([user_id], map: "idx_activity_log_user")
}

model agency {
  id                             Int       @id @default(autoincrement())
  name                           String    @db.VarChar(255)
  address                        String
  cities_served                  String[]
  phone                          String    @db.VarChar(20)
  email                          String?   @db.VarChar(100)
  logo                           String?   @db.VarChar(255)
  opening_hours                  String?   @db.VarChar(50)
  custom_hours                   Json?
  is_deleted                     Boolean?  @default(false)
  deleted_at                     DateTime? @db.Timestamp(6)
  deleted_by                     Int?
  created_by                     Int?
  users_agency_created_byTousers users?    @relation("agency_created_byTousers", fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users_agency_deleted_byTousers users?    @relation("agency_deleted_byTousers", fields: [deleted_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  bus                            bus[]
  trip                           trip[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model ai_responses {
  id                        Int       @id @default(autoincrement())
  intent                    String    @db.VarChar(50)
  keywords                  String[]  @db.VarChar(100)
  pattern                   String?
  response_template         String
  response_type             String?   @default("text") @db.VarChar(20)
  language                  String    @default("en") @db.VarChar(2)
  quick_reply_ids           Int[]
  priority                  Int?      @default(0)
  confidence_threshold      Decimal?  @default(0.70) @db.Decimal(3, 2)
  is_active                 Boolean?  @default(true)
  trigger_on_first_message  Boolean?  @default(false)
  max_uses_per_conversation Int?
  usage_count               Int?      @default(0)
  success_rate              Decimal?  @db.Decimal(5, 2)
  created_at                DateTime? @default(now()) @db.Timestamp(6)
  updated_at                DateTime? @default(now()) @db.Timestamp(6)
  created_by                Int?
  users                     users?    @relation(fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([intent], map: "idx_ai_responses_intent", where: raw("(is_active = true)"))
  @@index([priority(sort: Desc)], map: "idx_ai_responses_priority", where: raw("(is_active = true)"))
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model booking {
  id                                     Int                 @id @default(autoincrement())
  booking_reference                      String              @unique @db.VarChar(20)
  payment_method                         String              @db.VarChar(20)
  generated_trip_id                      Int
  generated_trip_seat_id                 Int                 @unique(map: "idx_no_double_booking", where: raw("((status)::text = ANY ((ARRAY['confirmed'::character varying, 'pending'::character varying])::text[]))"))
  customer_id                            Int
  base_price                             Int?
  seat_price_adjustment                  Decimal?            @default(0.00) @db.Decimal(10, 2)
  taxes                                  Decimal?            @default(0.00) @db.Decimal(10, 2)
  discount                               Decimal?            @default(0.00) @db.Decimal(10, 2)
  total_price                            Int
  status                                 String              @default("pending") @db.VarChar(20)
  booking_date                           DateTime?           @default(now()) @db.Timestamp(6)
  confirmation_date                      DateTime?           @db.Timestamp(6)
  cancellation_date                      DateTime?           @db.Timestamp(6)
  completion_date                        DateTime?           @db.Timestamp(6)
  cancellation_reason                    String?
  special_requests                       String?
  payment_reference                      String?             @db.VarChar(100)
  payment_status                         String?             @default("unpaid") @db.VarChar(20)
  created_by                             Int
  updated_at                             DateTime?           @default(now()) @db.Timestamp(6)
  is_deleted                             Boolean?            @default(false)
  deleted_at                             DateTime?           @db.Timestamp(6)
  deleted_by                             Int?
  group_id                               String?             @db.VarChar(50)
  reminder_sent_at                       DateTime?           @db.Timestamp(6)
  customer_booking_created_byTocustomer  customer            @relation("booking_created_byTocustomer", fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  customer_booking_customer_idTocustomer customer            @relation("booking_customer_idTocustomer", fields: [customer_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users                                  users?              @relation(fields: [deleted_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  generated_trip                         generated_trip      @relation(fields: [generated_trip_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  generated_trip_seat                    generated_trip_seat @relation(fields: [generated_trip_seat_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  booking_passenger                      booking_passenger[]

  @@index([group_id], map: "idx_booking_group_id")
}

model booking_passenger {
  id              Int      @id @default(autoincrement())
  booking_id      Int?
  name            String?  @db.VarChar(100)
  phone           String?  @db.VarChar(30)
  document_type   String?  @db.VarChar(20)
  document_number String?  @db.VarChar(50)
  booking         booking? @relation(fields: [booking_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model bus {
  id                          Int              @id @default(autoincrement())
  registration_number         String?          @unique @db.VarChar(50)
