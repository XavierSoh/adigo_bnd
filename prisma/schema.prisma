  dropoff_latitude    Decimal             @db.Decimal(10, 8)
  dropoff_longitude   Decimal             @db.Decimal(11, 8)
  dropoff_time        DateTime?           @db.Timestamp(6)
  base_fare           Decimal             @db.Decimal(10, 2)
  distance_fare       Decimal?            @default(0) @db.Decimal(10, 2)
  time_fare           Decimal?            @default(0) @db.Decimal(10, 2)
  surge_multiplier    Decimal?            @default(1.0) @db.Decimal(3, 2)
  total_fare          Decimal             @db.Decimal(10, 2)
  status              String?             @default("requested") @db.VarChar(20)
  cancellation_reason String?
  cancelled_by        String?             @db.VarChar(20)
  customer_rating     Int?
  driver_rating       Int?
  customer_feedback   String?
  driver_feedback     String?
  payment_method      String              @db.VarChar(50)
  payment_status      String?             @default("pending") @db.VarChar(20)
  estimated_distance  Decimal?            @db.Decimal(10, 2)
  actual_distance     Decimal?            @db.Decimal(10, 2)
  estimated_duration  Int?
  actual_duration     Int?
  created_at          DateTime?           @default(now()) @db.Timestamp(6)
  updated_at          DateTime?           @default(now()) @db.Timestamp(6)
  vtc_ride_tracking   vtc_ride_tracking[]
  customer            customer            @relation(fields: [customer_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  vtc_drivers         vtc_drivers?        @relation(fields: [driver_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([customer_id], map: "idx_vtc_rides_customer")
  @@index([driver_id], map: "idx_vtc_rides_driver")
  @@index([status], map: "idx_vtc_rides_status")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model wallet {
  id                Int       @id @default(autoincrement())
  customer_id       Int       @unique
  balance           Int       @default(0)
  transaction_count Int?      @default(0)
  total_credits     Int?      @default(0)
  total_debits      Int?      @default(0)
  created_at        DateTime? @default(now()) @db.Timestamp(6)
  updated_at        DateTime? @db.Timestamp(6)
  customer          customer  @relation(fields: [customer_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([customer_id], map: "idx_wallet_customer")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model wallet_transaction {
  id                  Int                   @id @default(autoincrement())
  customer_id         Int
  amount              Int
  transaction_type    String                @db.VarChar(20)
  payment_method      String?               @db.VarChar(20)
  payment_reference   String?               @db.VarChar(100)
  description         String?
  balance_before      Int
  balance_after       Int
  created_at          DateTime?             @default(now()) @db.Timestamp(6)
  event_ticket_resale event_ticket_resale[]
  customer            customer              @relation(fields: [customer_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model system_settings {
  id            Int       @id @default(autoincrement())
  category      String    @db.VarChar(50)
  setting_key   String    @db.VarChar(100)
  setting_value String?
  description   String?
  updated_at    DateTime? @db.Timestamp(6)
  updated_by    Int?
  is_deleted    Boolean   @default(false)
  users         users?    @relation(fields: [updated_by], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([category, setting_key], map: "uq_system_settings_category_key")
}
